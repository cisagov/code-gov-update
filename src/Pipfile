[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Minimum version for IMDSv2 support
boto3 = ">=1.13.25"
# We need to use the system package version of this package. This matches the version
# available for Alpine Linux 3.24. We must also ignore dependabot updates for this
# dependency as long as we are using the system package.
cryptography = "47.0.0"
docopt = ">=0.6.2"
# 0.15.0 is the minimum version compatible with newer versions of cloc.
#
# 0.17.0 is the minimum version compatible with non-ancient versions of
# setuptools.  See llnl/scraper#88 and llnl/scraper#90 for more
# details.
llnl-scraper = ">=0.17.0"

[requires]
python_full_version = "3.14.10"
